venv/

# Артефакты оффлайн-прогонов (tools/replay.py, run_on_video.py)
run_output/
разбор/
*.log

# Записи попыток и журнал хаба: их место в облаке команды, а не в git.
# Всё это пишется в records/ (config.yaml -> mission.record_dir, hub.py --log);
# маски по имени оставлены для записей, прилетевших с борта или из старых запусков.
records/
flight_*.mp4
flight_*.jsonl
hub_log.jsonl

# Отчёты диагностики борта — результат переносится в config.yaml руками
tools/check_sdk_report.txt
tools/check_axes_report.txt
tools/check_sdk_frame.png

# Редакторы и ОС
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# PDF держим только в source/ — в корень они попадают из загрузок случайно
/*.pdf

# Фотографии с площадки: в корень попадают из мессенджера, в репозиторий не идут
# (картинки к документам живут в docs/assets/ и добавляются осознанно)
/*.jpg
/*.jpeg
/*.png
